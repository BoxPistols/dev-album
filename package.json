{
  "name": "dev-album",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "freshness": "node scripts/check-content-freshness.mjs",
    "check:sources": "tsx scripts/verify-sources.mjs",
    "check:quotes": "node scripts/trim-quotes.mjs",
    "fix:quotes": "node scripts/trim-quotes.mjs --write",
    "check:verdicts": "node scripts/verify-verdicts.mjs docs/audits/2026-08-16-medium-verdicts.json",
    "check:verdicts:low": "node scripts/verify-verdicts.mjs docs/audits/2026-08-16-low-verdicts.json",
    "check:verdicts:reaudit": "node scripts/verify-verdicts.mjs docs/audits/2026-08-23-reaudit-verdicts.json",
    "claim:coverage": "node scripts/claim-coverage.mjs",
    "check:verdicts:followup": "node scripts/verify-verdicts.mjs docs/audits/2026-08-23-followup-verdicts.json",
    "check:quote-fragments": "node scripts/check-quote-fragments.mjs",
    "check:links": "node scripts/check-links.mjs",
    "fix:links": "node scripts/fix-redirected-links.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:freshness": "tsx scripts/check-source-freshness.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.19",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.15.0",
    "openai": "^6.32.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.2",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.183.1",
    "@vercel/node": "^5.7.15",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.22",
    "prettier": "^3.6.2",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.4.1"
}
